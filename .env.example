POSTGRES_DB=hanye
POSTGRES_USER=hanye
POSTGRES_PASSWORD=hanye_dev_password
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://oa.hanyeltd.com
TZ=Asia/Shanghai
BACKUP_INTERVAL_SECONDS=86400
# 发布时默认关闭启动数据库维护，避免代码发布时自动改库；本地需要自动维护时可改成 1
STARTUP_DB_MAINTENANCE=1
SEED_DEMO_DATA=0

# 阿里云 OSS 附件存储；正式附件必须配置 OSS，未配置时附件上传不可用。
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_INTERNAL=0
OSS_SECURE=1
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_KEY_PREFIX=hanye-system/uploads
OSS_SIGNED_URL_EXPIRES_SECONDS=3600
