<view class="page-shell dispatch-page">
  <view class="page-head">
    <view>
      <text class="page-title">排车表</text>
      <text class="page-subtitle">{{dateLabel}} · {{accountLabel}}</text>
    </view>
    <button class="quiet-btn head-btn" bindtap="logout">退出</button>
  </view>

  <view class="panel date-panel">
    <button class="ghost-btn date-nav" data-offset="-1" bindtap="changeDateByOffset">前一天</button>
    <picker mode="date" value="{{dispatchDate}}" bindchange="onDatePickerChange">
      <view class="date-picker">
        <text>{{dispatchDate}}</text>
        <text class="date-picker-sub">{{dateLabel}}</text>
      </view>
    </picker>
    <button class="ghost-btn date-nav" data-offset="1" bindtap="changeDateByOffset">后一天</button>
    <button class="quiet-btn today-btn" bindtap="goToday">今天</button>
  </view>

  <view class="toolbar">
    <button class="primary-btn toolbar-btn" bindtap="openNewDispatch" disabled="{{loading || saving}}">新建排车</button>
    <button class="ghost-btn toolbar-btn" bindtap="copyVisibleDispatchText" disabled="{{loading || saving}}">复制文本</button>
    <button class="ghost-btn toolbar-btn" bindtap="syncRowsToOrders" disabled="{{loading || saving}}">同步订单</button>
    <button class="quiet-btn toolbar-btn small" bindtap="refreshTap" loading="{{loading}}" disabled="{{saving}}">刷新</button>
  </view>

  <scroll-view scroll-x class="summary-scroll">
    <view class="summary-track">
      <view wx:for="{{summaryCards}}" wx:key="key" class="summary-card {{item.className}} {{item.active ? 'active' : ''}}" data-status="{{item.key}}" bindtap="setStatusFilter">
        <text>{{item.label}}</text>
        <text class="summary-number">{{item.value}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{warnings.length}}" class="panel warning-panel">
    <view class="warning-title">风险提示 · {{warnings.length}} 条</view>
    <view wx:for="{{warnings}}" wx:key="*this" class="warning-line">{{item}}</view>
  </view>

  <view class="search-row">
    <input placeholder="搜索客户、车牌、订单号、口岸、地址" placeholder-class="placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" />
    <button wx:if="{{searchKeyword}}" class="quiet-btn clear-btn" bindtap="clearSearch">清空</button>
  </view>

  <view class="tab-row">
    <button class="tab-btn {{activeTab === 'dispatch' ? 'active' : ''}}" data-tab="dispatch" bindtap="switchTab">排车表 {{displayRows.length}}</button>
    <button class="tab-btn {{activeTab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="switchTab">待排订单 {{unplannedOrders.length}}</button>
  </view>

  <view wx:if="{{loading}}" class="loading-box">正在读取排车数据...</view>

  <block wx:else>
    <view wx:if="{{activeTab === 'dispatch'}}" class="list-area">
      <view wx:if="{{!displayRows.length}}" class="empty-box">当前条件下暂无排车单</view>
      <view wx:for="{{displayRows}}" wx:key="id" class="dispatch-card">
        <view class="card-head" data-id="{{item.id}}" bindtap="toggleExpand">
          <view class="card-title-wrap">
            <text class="dispatch-no">{{item.dispatchNo || '未编号'}}</text>
            <text class="order-no">订单 {{item.orderNoText}}</text>
          </view>
          <text class="status-chip {{item.statusClass}}">{{item.status}}</text>
        </view>
        <view class="customer-line">{{item.customerText}}</view>
        <view class="meta-line">
          <text>{{item.timeText}}</text>
          <text>{{item.plate || '-'}}</text>
          <text>{{item.port || '-'}}</text>
          <text>{{item.direction || '-'}}</text>
          <text>{{item.tonnage || '-'}}</text>
        </view>
        <view class="route-line">{{item.routeText}}</view>
        <view class="tag-row">
          <text class="source-tag {{item.sourceClass}}">{{item.sourceText}}</text>
          <text class="driver-tag">司机 {{item.driverText}}</text>
          <text wx:if="{{item.orderStatusText}}" class="order-status-tag">订单 {{item.orderStatusText}}</text>
        </view>
        <view wx:if="{{item.expanded}}" class="expanded-area">
          <view class="detail-line"><text>装货地</text><text>{{item.loading || '-'}}</text></view>
          <view class="detail-line"><text>卸货地</text><text>{{item.unloading || '-'}}</text></view>
          <view class="detail-line"><text>外派供应商</text><text>{{item.supplier || '-'}}</text></view>
          <view class="detail-line"><text>备注</text><text>{{item.noteText || '-'}}</text></view>
        </view>
        <view class="card-actions">
          <button class="ghost-btn card-btn" data-id="{{item.id}}" bindtap="openStatusActions" loading="{{saving}}">状态</button>
          <button class="ghost-btn card-btn" data-id="{{item.id}}" bindtap="openEditDispatch">编辑</button>
          <button class="quiet-btn card-btn" data-id="{{item.id}}" bindtap="openMoreActions">更多</button>
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'orders'}}" class="list-area">
      <view wx:if="{{!unplannedOrders.length}}" class="empty-box">当天没有待排运输订单</view>
      <view wx:for="{{unplannedOrders}}" wx:key="no" class="order-card">
        <view class="card-head">
          <view class="card-title-wrap">
            <text class="dispatch-no">{{item.no}}</text>
            <text class="order-no">{{item.dispatchNo || '未分配排车号'}}</text>
          </view>
          <text class="source-tag {{item.sourceClass}}">{{item.sourceText}}</text>
        </view>
        <view class="customer-line">{{item.customer}}</view>
        <view class="meta-line">
          <text>{{item.plate}}</text>
          <text>{{item.port}}</text>
          <text>{{item.direction}}</text>
          <text>{{item.tonnage}}</text>
        </view>
        <view class="route-line">{{item.routeText}}</view>
        <view class="order-card-footer">
          <text>{{item.quantityText}} · {{item.status}}</text>
          <button class="primary-btn card-btn" data-no="{{item.no}}" bindtap="addOrderToPlan" loading="{{saving}}">加入排车</button>
        </view>
      </view>
    </view>
  </block>
</view>
