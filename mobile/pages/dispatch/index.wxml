<view class="page-shell dispatch-page">
  <view class="page-head">
    <view class="page-head-main">
      <text class="page-title">{{activeModule === 'orders' ? '订单管理' : '排车表'}}</text>
      <text class="page-subtitle">{{accountLabel}}</text>
    </view>
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <view wx:if="{{warnings.length}}" class="warning-entry" bindtap="openWarningsPanel">
    <view class="warning-entry-copy">
      <text class="warning-entry-title">证件提醒</text>
      <text class="warning-entry-sub">30天内到期 / 已过期</text>
    </view>
    <text class="warning-entry-count">{{warnings.length}}条</text>
  </view>

  <view class="module-tabs">
    <view class="module-tab {{activeModule === 'dispatch' ? 'active' : ''}}" data-module="dispatch" bindtap="switchModule">排车表</view>
    <view class="module-tab {{activeModule === 'orders' ? 'active' : ''}}" data-module="orders" bindtap="switchModule">订单管理</view>
  </view>

  <view class="panel date-panel">
    <picker mode="date" value="{{dispatchDate}}" bindchange="onDatePickerChange">
      <view class="date-picker">
        <text>{{dispatchDate}}</text>
        <text class="date-picker-sub">{{currentOrderLabel}}</text>
      </view>
    </picker>
    <view class="date-actions">
      <view class="date-action-btn" hover-class="tap-muted" data-offset="-1" bindtap="changeDateByOffset">前一天</view>
      <view class="date-action-btn today" hover-class="tap-muted" bindtap="goToday">今天</view>
      <view class="date-action-btn" hover-class="tap-muted" data-offset="1" bindtap="changeDateByOffset">后一天</view>
    </view>
  </view>

  <view wx:if="{{activeModule === 'dispatch'}}" class="toolbar">
    <button class="primary-btn toolbar-btn" bindtap="openNewDispatch" disabled="{{loading || saving || formOpening || dispatchInfoBusy}}">新建排车</button>
    <button class="ghost-btn toolbar-btn" bindtap="generateSelectedDispatchInfo" loading="{{dispatchInfoBusy}}" disabled="{{loading || saving || formOpening || dispatchInfoBusy || !selectedDispatchCount}}">{{dispatchInfoBusy ? '生成中...' : '生成派车信息'}}</button>
    <button class="ghost-btn toolbar-btn" bindtap="copySelectedDispatchRow" disabled="{{loading || saving || formOpening || dispatchInfoBusy || !selectedDispatchCount}}">复制排车单</button>
    <button class="quiet-btn toolbar-btn" bindtap="toggleAllVisibleDispatchSelection" disabled="{{loading || saving || formOpening || dispatchInfoBusy || !displayRows.length}}">{{allVisibleDispatchRowsSelected ? '取消全选' : '全选'}}</button>
  </view>
  <view wx:if="{{activeModule === 'dispatch' && selectedDispatchCount}}" class="selection-summary">已选 {{selectedDispatchCount}} 单</view>

  <view wx:if="{{activeModule === 'dispatch'}}" class="summary-grid">
    <view wx:for="{{summaryCards}}" wx:key="key" class="summary-card {{item.className}} {{item.active ? 'active' : ''}}" data-status="{{item.key}}" bindtap="setStatusFilter">
      <text>{{item.label}}</text>
      <text class="summary-number">{{item.value}}</text>
    </view>
  </view>

  <view class="search-row">
    <input placeholder="{{activeModule === 'orders' ? '搜索订单号、客户、车牌、司机、地址' : '搜索客户、车牌、订单号、口岸、地址'}}" placeholder-class="placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" />
    <button wx:if="{{searchKeyword}}" class="quiet-btn clear-btn" bindtap="clearSearch">清空</button>
  </view>

  <view wx:if="{{loading}}" class="loading-box">正在读取{{activeModule === 'orders' ? '订单' : '排车'}}数据...</view>

  <block wx:else>
    <view wx:if="{{activeModule === 'dispatch'}}" class="list-area">
      <view wx:if="{{!displayRows.length}}" class="empty-box">{{emptyText}}</view>
      <view wx:for="{{displayRows}}" wx:key="id" class="dispatch-card {{item.selected ? 'selected' : ''}} {{item.opening ? 'opening' : ''}}">
        <view class="card-head" data-id="{{item.id}}" bindtap="toggleExpand">
          <view class="card-head-main">
            <view class="card-select {{item.selected ? 'checked' : ''}}" catchtap="toggleDispatchSelection" data-id="{{item.id}}">
              <view class="card-select-mark"></view>
            </view>
            <view class="card-title-wrap">
              <text class="dispatch-no">{{item.dispatchNo || '未编号'}}</text>
              <text class="order-no">订单 {{item.orderNoText}}</text>
            </view>
          </view>
          <text class="status-chip {{item.statusClass}}">{{item.status}}</text>
        </view>
        <view class="customer-line">{{item.customerText}}</view>
        <view class="highlight-line">
          <text class="highlight-pill time">时间 {{item.highlightTimeText || item.timeText}}</text>
          <text class="highlight-pill plate">车牌 {{item.highlightPlateText || item.plate || '-'}}</text>
          <text wx:if="{{item.supplierHighlightText}}" class="highlight-pill supplier">外派 {{item.supplierHighlightText}}</text>
        </view>
        <view class="meta-line">
          <text>{{item.dateText || dispatchDate}}</text>
          <text>{{item.port || '-'}}</text>
          <text>{{item.direction || '-'}}</text>
          <text>{{item.tonnage || '-'}}</text>
          <text>{{item.weighingText}}</text>
        </view>
        <view class="route-line">{{item.routeText}}</view>
        <view class="tag-row">
          <text wx:if="{{item.businessTypeText}}" class="business-tag">{{item.businessTypeText}}</text>
          <text class="source-tag {{item.sourceClass}}">{{item.sourceText}}</text>
          <text class="driver-tag">司机 {{item.driverText}}</text>
          <text wx:if="{{item.creatorText}}" class="creator-tag">创建者 {{item.creatorText}}</text>
          <text wx:if="{{item.orderStatusText}}" class="order-status-tag">订单 {{item.orderStatusText}}</text>
        </view>
        <view wx:if="{{item.expanded}}" class="expanded-area">
          <view class="detail-line"><text>装货地</text><text class="detail-value multiline">{{item.loading || '-'}}</text></view>
          <view class="detail-line"><text>卸货地</text><text class="detail-value multiline">{{item.unloading || '-'}}</text></view>
          <view class="detail-line"><text>外派供应商</text><text>{{item.supplier || '-'}}</text></view>
          <view class="detail-line"><text>备注</text><text>{{item.noteText || '-'}}</text></view>
        </view>
        <view class="card-actions">
          <view class="card-action-btn secondary {{saving || formOpening || item.statusActionDisabled ? 'disabled' : ''}}" data-id="{{item.id}}" catchtap="openStatusActions">更改状态</view>
          <view class="card-action-btn secondary {{saving || formOpening ? 'disabled' : ''}} {{item.opening ? 'loading' : ''}}" data-id="{{item.id}}" catchtap="openEditDispatch">
            <view wx:if="{{item.opening}}" class="inline-spinner"></view>
            <text>{{item.opening ? '打开中...' : '编辑'}}</text>
          </view>
          <view class="card-action-btn quiet {{saving || formOpening ? 'disabled' : ''}}" data-id="{{item.id}}" catchtap="openMoreActions">更多</view>
          <view class="card-action-btn return {{saving || formOpening || !item.returnStatus ? 'disabled' : ''}}" data-id="{{item.id}}" catchtap="returnRowStatus">返回</view>
        </view>
      </view>
    </view>

    <view wx:elif="{{activeModule === 'orders'}}" class="list-area">
      <view wx:if="{{!orderDisplayRows.length}}" class="empty-box">{{orderEmptyText}}</view>
      <view wx:for="{{orderDisplayRows}}" wx:key="no" class="order-card {{item.opening ? 'opening' : ''}}">
        <view class="card-head" data-no="{{item.no}}" bindtap="toggleOrderExpand">
          <view class="card-head-main">
            <view class="card-title-wrap">
              <text class="dispatch-no">{{item.no || '未编号'}}</text>
              <text class="order-no">排车 {{item.dispatchNo || '-'}}</text>
            </view>
          </view>
          <text class="status-chip {{item.statusClass}}">{{item.status}}</text>
        </view>
        <view class="customer-line">{{item.customerText}}</view>
        <view class="highlight-line">
          <text class="highlight-pill time">时间 {{item.highlightTimeText || '-'}}</text>
          <text class="highlight-pill plate">车牌 {{item.highlightPlateText || item.plate || '-'}}</text>
          <text wx:if="{{item.supplierHighlightText}}" class="highlight-pill supplier">外派 {{item.supplierHighlightText}}</text>
        </view>
        <view class="meta-line">
          <text>{{item.date || dispatchDate}}</text>
          <text>{{item.port || '-'}}</text>
          <text>{{item.direction || '-'}}</text>
          <text>{{item.tonnage || '-'}}</text>
          <text>{{item.needsWeighing ? '过磅' : '不用过磅'}}</text>
        </view>
        <view class="route-line">{{item.routeText}}</view>
        <view class="tag-row">
          <text class="source-tag {{item.vehicleSource === '外派车辆' ? 'source-outsourced' : item.vehicleSource === '汉业物流' ? 'source-own' : 'source-empty'}}">{{item.vehicleSource || '-'}}</text>
          <text class="driver-tag">司机 {{item.driverText}}</text>
          <text class="order-status-tag">应收 {{item.amountText}}</text>
        </view>
        <view wx:if="{{item.expanded}}" class="expanded-area">
          <view class="detail-line"><text>业务类型</text><text>{{item.businessType || '-'}}</text></view>
          <view class="detail-line"><text>运输模式</text><text>{{item.transportMode || '-'}}</text></view>
          <view class="detail-line"><text>装货地</text><text class="detail-value multiline">{{item.loading || '-'}}</text></view>
          <view class="detail-line"><text>卸货地</text><text class="detail-value multiline">{{item.unloading || '-'}}</text></view>
          <view class="detail-line"><text>备注</text><text>{{item.remark || '-'}}</text></view>
        </view>
        <view class="card-actions order-actions">
          <view class="card-action-btn exception {{saving || formOpening || item.exceptionDisabled ? 'disabled' : ''}}" data-no="{{item.no}}" data-status="异常滞留" catchtap="updateOrderStatusFromCard">异常滞留</view>
          <view class="card-action-btn signed {{saving || formOpening || item.signedDisabled ? 'disabled' : ''}}" data-no="{{item.no}}" data-status="已签收" catchtap="updateOrderStatusFromCard">已签收</view>
          <view class="card-action-btn secondary {{saving || formOpening ? 'disabled' : ''}} {{item.opening ? 'loading' : ''}}" data-no="{{item.no}}" catchtap="openEditOrder">
            <view wx:if="{{item.opening}}" class="inline-spinner"></view>
            <text>{{item.opening ? '打开中...' : '编辑'}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{formOpening}}" class="form-opening-mask">
    <view class="form-opening-card">
      <view class="form-opening-spinner"></view>
      <view class="form-opening-copy">
        <text class="form-opening-title">{{formOpeningText || '正在打开排车单...'}}</text>
        <text class="form-opening-subtitle">正在读取排车单资料，请稍候</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showWarningsPanel}}" class="sheet-mask" bindtap="closeWarningsPanel">
    <view class="warning-sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-head-copy">
          <text class="sheet-title">证件到期提醒</text>
          <text class="sheet-subtitle">30天内到期 / 已过期</text>
        </view>
        <button class="quiet-btn sheet-close" bindtap="closeWarningsPanel">关闭</button>
      </view>
      <scroll-view scroll-y class="warning-sheet-list">
        <view wx:for="{{warnings}}" wx:key="*this" class="warning-sheet-line">{{item}}</view>
      </scroll-view>
    </view>
  </view>
</view>
