.dispatch-page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding-top: 8rpx;
}

.page-head-main {
  flex: 1;
  min-width: 0;
  padding-right: 14rpx;
}

.page-title {
  display: block;
  color: #14213d;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #607089;
  font-size: 24rpx;
}

.logout-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 108rpx;
  min-height: 54rpx;
  margin: 0;
  padding: 7rpx 8rpx;
  border: 1rpx solid #d5dfec;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f6f9fd 100%);
  color: #29405f;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.1;
  box-shadow: 0 6rpx 16rpx rgba(21, 37, 64, 0.1);
}

.module-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6rpx;
  margin-bottom: 18rpx;
  padding: 6rpx;
  border: 1rpx solid #d9e1ec;
  border-radius: 8rpx;
  background: #eef3f9;
}

.module-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  border-radius: 6rpx;
  color: #38516f;
  font-size: 25rpx;
  font-weight: 900;
}

.module-tab.active {
  background: #ffffff;
  color: #1769e0;
  box-shadow: 0 6rpx 16rpx rgba(21, 37, 64, 0.1);
}

.date-panel {
  padding: 18rpx;
}

.date-panel picker {
  display: block;
  width: 100%;
  min-width: 0;
}

.date-actions {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  width: 100%;
  min-width: 0;
}

.date-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 56rpx;
  border: 1rpx solid #cbd7e7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #29405f;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-action-btn + .date-action-btn {
  margin-left: 10rpx;
}

.date-action-btn.today {
  flex: 0 0 108rpx;
  background: #eef3f9;
  color: #38516f;
}

.tap-muted {
  opacity: 0.72;
}

.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  width: 100%;
  min-width: 0;
  border: 1rpx solid #d9e1ec;
  border-radius: 8rpx;
  background: #f8fbff;
  padding: 0 24rpx;
}

.date-picker text {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 800;
  white-space: nowrap;
}

.date-picker-sub {
  color: #607089;
  font-size: 24rpx !important;
  font-weight: 700 !important;
}

.toolbar {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  row-gap: 12rpx;
  column-gap: 12rpx;
  margin-bottom: 12rpx;
}

.toolbar-btn {
  width: 100%;
  min-width: 0;
  min-height: 68rpx;
  padding: 0 10rpx;
  font-size: 24rpx;
}

.toolbar-btn.small {
  font-size: 22rpx;
}

.selection-summary {
  margin: -2rpx 0 18rpx;
  color: #1769e0;
  font-size: 22rpx;
  font-weight: 800;
  text-align: right;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.summary-card {
  min-width: 0;
  min-height: 96rpx;
  padding: 14rpx 16rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
}

.summary-card.active {
  border-color: #1769e0;
  box-shadow: 0 8rpx 24rpx rgba(23, 105, 224, 0.16);
}

.summary-card text {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.1;
  white-space: nowrap;
}

.summary-number {
  margin-top: 8rpx;
  font-size: 32rpx !important;
  font-weight: 800 !important;
}

.warning-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
  margin: 0 0 12rpx;
  padding: 0 16rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 8rpx;
  background: #fff8ed;
}

.warning-entry-copy {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.warning-entry-title {
  color: #9a3412;
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.warning-entry-sub {
  margin-left: 12rpx;
  color: #b45309;
  font-size: 21rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.warning-entry-count {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #fed7aa;
  color: #9a3412;
  font-size: 21rpx;
  font-weight: 900;
}

.search-row {
  display: grid;
  grid-template-columns: 1fr auto;
  column-gap: 12rpx;
  margin-bottom: 18rpx;
}

.clear-btn {
  min-width: 112rpx;
  min-height: 72rpx;
}

.loading-box,
.empty-box {
  padding: 44rpx 20rpx;
  border: 1rpx dashed #cbd7e7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #607089;
  text-align: center;
}

.dispatch-card,
.order-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(21, 37, 64, 0.06);
}

.dispatch-card.selected {
  border-color: #9cc4ff;
  background: #f7fbff;
  box-shadow: 0 12rpx 30rpx rgba(23, 105, 224, 0.11);
}

.dispatch-card.opening,
.order-card.opening {
  border-color: #9cc4ff;
  background: #f7fbff;
  box-shadow: 0 12rpx 32rpx rgba(23, 105, 224, 0.16);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  column-gap: 16rpx;
  min-width: 0;
}

.card-head-main {
  display: flex;
  flex: 1;
  align-items: flex-start;
  min-width: 0;
  column-gap: 12rpx;
}

.card-select {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
  border: 2rpx solid #cbd7e7;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.65);
}

.card-select.checked {
  border-color: #1769e0;
  background: #1769e0;
  box-shadow: 0 6rpx 16rpx rgba(23, 105, 224, 0.18);
}

.card-select-mark {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: transparent;
}

.card-select.checked .card-select-mark {
  background: #ffffff;
}

.card-title-wrap {
  flex: 1;
  min-width: 0;
}

.dispatch-no {
  display: block;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  word-break: break-all;
}

.order-no {
  display: block;
  margin-top: 4rpx;
  color: #6a7890;
  font-size: 22rpx;
}

.customer-line {
  margin-top: 16rpx;
  color: #23344d;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.highlight-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 14rpx;
}

.highlight-pill {
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.15;
  white-space: nowrap;
}

.highlight-pill.time {
  background: #e8f1ff;
  color: #174ea6;
}

.highlight-pill.plate {
  background: #ecfdf5;
  color: #047857;
}

.highlight-pill.supplier {
  background: #fff7ed;
  color: #b45309;
}

.meta-line {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.meta-line text {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #3f5068;
  font-size: 22rpx;
}

.route-line {
  margin-top: 4rpx;
  color: #334155;
  font-size: 25rpx;
  line-height: 1.45;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 14rpx;
}

.source-tag,
.business-tag,
.driver-tag,
.creator-tag,
.order-status-tag {
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.business-tag {
  background: #fff7ed;
  color: #b45309;
}

.driver-tag {
  background: #f0f5ff;
  color: #334e9a;
}

.creator-tag {
  background: #ecfdf5;
  color: #047857;
}

.order-status-tag {
  background: #eef2f7;
  color: #475569;
}

.expanded-area {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf2f7;
}

.detail-line {
  display: grid;
  grid-template-columns: 140rpx 1fr;
  column-gap: 12rpx;
  margin-top: 10rpx;
  color: #52627a;
  font-size: 23rpx;
  line-height: 1.45;
}

.detail-line text:first-child {
  color: #8a97aa;
}

.detail-value {
  min-width: 0;
  word-break: break-all;
}

.detail-value.multiline {
  white-space: pre-wrap;
}

.card-actions {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.card-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  height: 54rpx;
  min-width: 0;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-action-btn + .card-action-btn {
  margin-left: 10rpx;
}

.card-action-btn.secondary {
  border: 1rpx solid #cbd7e7;
  background: #ffffff;
  color: #29405f;
}

.card-action-btn.quiet {
  background: #eef3f9;
  color: #38516f;
}

.card-action-btn.return {
  border: 1rpx solid #b7d5f8;
  background: #eef6ff;
  color: #0b74de;
}

.card-action-btn.signed {
  background: #047857;
  color: #ffffff;
}

.card-action-btn.exception {
  background: #b91c1c;
  color: #ffffff;
}

.card-action-btn.disabled {
  opacity: 0.55;
  background: #e5eaf1;
  color: #8a97aa;
}

.card-action-btn.loading {
  opacity: 1;
  border-color: #1769e0;
  background: #1769e0;
  color: #ffffff;
}

.inline-spinner {
  width: 22rpx;
  height: 22rpx;
  margin-right: 8rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: dispatch-spin 0.8s linear infinite;
}

.form-opening-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(15, 23, 42, 0.18);
  pointer-events: auto;
}

.form-opening-card {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 560rpx;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #c7dcff;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.18);
}

.form-opening-spinner {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
  border: 5rpx solid #d9e8ff;
  border-top-color: #1769e0;
  border-radius: 50%;
  animation: dispatch-spin 0.8s linear infinite;
}

.form-opening-copy {
  min-width: 0;
}

.form-opening-title,
.form-opening-subtitle {
  display: block;
}

.form-opening-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.3;
}

.form-opening-subtitle {
  margin-top: 6rpx;
  color: #607089;
  font-size: 22rpx;
  line-height: 1.35;
}

@keyframes dispatch-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.order-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  color: #607089;
  font-size: 23rpx;
}

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.38);
}

.warning-sheet {
  width: 100%;
  max-height: 70vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 20rpx 20rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -16rpx 40rpx rgba(15, 23, 42, 0.16);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 18rpx;
  width: 100%;
  margin-bottom: 18rpx;
}

.sheet-head-copy {
  flex: 1;
  min-width: 0;
}

.sheet-title,
.sheet-subtitle {
  display: block;
}

.sheet-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.sheet-subtitle {
  margin-top: 6rpx;
  color: #8a97aa;
  font-size: 22rpx;
}

.sheet-close {
  flex: 0 0 auto;
  margin-left: auto;
  min-width: 92rpx;
  min-height: 48rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
}

.warning-sheet-list {
  max-height: 52vh;
}

.warning-sheet-line {
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 8rpx;
  background: #fff8ed;
  color: #9a3412;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}
