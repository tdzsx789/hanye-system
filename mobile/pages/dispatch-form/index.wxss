.form-page {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.form-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.form-title {
  display: block;
  color: #14213d;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.form-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #607089;
  font-size: 24rpx;
}

.loading-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 16rpx;
  padding: 40rpx 20rpx;
  color: #607089;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.loading-spinner {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #d9e6f8;
  border-top-color: #1769e0;
  border-radius: 50%;
  animation: form-loading-spin 0.8s linear infinite;
}

@keyframes form-loading-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.form-panel {
  padding: 24rpx;
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
}

.field-row {
  position: relative;
  margin-bottom: 22rpx;
}

.field-row:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #4b5d78;
  font-size: 24rpx;
  font-weight: 700;
}

.picker-box {
  min-height: 72rpx;
  border: 1rpx solid #d9e1ec;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 18rpx 24rpx;
  color: #172033;
  font-size: 28rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-box.disabled {
  background: #f3f6fa;
  color: #7a889d;
}

.address-area-picker {
  display: block;
}

.picker-box-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  column-gap: 12rpx;
}

.picker-box-trigger.empty {
  color: #8a97aa;
}

.picker-box-value {
  display: block;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-box-arrow {
  flex: 0 0 auto;
  color: #7a889d;
  font-size: 28rpx;
  line-height: 1;
}

.two-col {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  column-gap: 16rpx;
}

.customer-field {
  z-index: 2;
}

.suggestion-box {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 10;
  margin-top: 8rpx;
  border: 1rpx solid #d9e1ec;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 38rpx rgba(21, 37, 64, 0.14);
  overflow: hidden;
}

.suggestion-item {
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.suggestion-item text {
  display: block;
}

.suggestion-primary {
  color: #172033;
  font-size: 26rpx;
  font-weight: 800;
}

.suggestion-secondary {
  margin-top: 4rpx;
  color: #7b8798;
  font-size: 22rpx;
}

.suggestion-empty {
  padding: 22rpx;
  color: #8a97aa;
  font-size: 24rpx;
}

.suggestion-close {
  width: 100%;
  border-radius: 0;
}

.location-panel {
  display: block;
}

.location-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  column-gap: 16rpx;
  margin-bottom: 14rpx;
}

.location-hint {
  display: block;
  margin-top: 4rpx;
  color: #7a889d;
  font-size: 22rpx;
  line-height: 1.4;
}

.location-count {
  flex: 0 0 auto;
  border-radius: 999rpx;
  background: #e8f1ff;
  padding: 6rpx 14rpx;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.location-count.empty {
  background: #edf2f7;
  color: #7a889d;
}

.location-list {
  margin-bottom: 16rpx;
}

.location-empty-inline {
  margin-bottom: 16rpx;
  border: 1rpx dashed #cbd7e7;
  border-radius: 8rpx;
  background: #f8fbff;
  padding: 22rpx 20rpx;
  color: #7a889d;
  font-size: 24rpx;
  text-align: center;
}

.location-item {
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr);
  align-items: flex-start;
  column-gap: 12rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #dce5ef;
  border-radius: 8rpx;
  background: #f8fbff;
  padding: 14rpx 16rpx;
}

.location-item:last-child {
  margin-bottom: 0;
}

.location-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #e8f1ff;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 800;
}

.location-text {
  display: block;
  min-width: 0;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.location-text.empty {
  color: #7a889d;
}

.location-button {
  width: 100%;
  min-height: 64rpx;
  border: 1rpx dashed #b8c8dc;
  background: #f8fbff;
  color: #1769e0;
  font-size: 24rpx;
}

.small {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(13, 21, 37, 0.5);
}

.location-picker-mask {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.location-sheet {
  width: 100%;
  max-height: 88vh;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 28rpx 60rpx rgba(9, 18, 34, 0.22);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  column-gap: 16rpx;
}

.sheet-head-copy {
  flex: 1;
  min-width: 0;
}

.sheet-title {
  display: block;
  max-width: 100%;
  color: #172033;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #607089;
  font-size: 22rpx;
  line-height: 1.4;
}

.sheet-close {
  flex: 0 0 auto;
  min-width: 104rpx;
  min-height: 54rpx;
  padding: 0 16rpx;
}

.location-toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  column-gap: 12rpx;
  margin-top: 18rpx;
}

.address-picker-note {
  margin-top: 14rpx;
  border-radius: 8rpx;
  background: #eef5ff;
  padding: 14rpx 16rpx;
  color: #1d4ed8;
  font-size: 22rpx;
  line-height: 1.5;
}

.location-search {
  min-height: 72rpx;
}

.location-new-btn {
  min-width: 154rpx;
  padding: 0 18rpx;
}

.address-form {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #dbe4f0;
  border-radius: 8rpx;
  background: #f8fbff;
}

.address-save-btn {
  width: 100%;
  margin-top: 4rpx;
}

.address-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  margin-bottom: 12rpx;
  color: #607089;
  font-size: 22rpx;
}

.address-empty {
  padding: 34rpx 20rpx;
  border: 1rpx dashed #cbd7e7;
  border-radius: 8rpx;
  background: #f8fbff;
  color: #607089;
  text-align: center;
  font-size: 24rpx;
}

.address-list {
  height: 44vh;
}

.address-card {
  display: grid;
  grid-template-columns: 46rpx minmax(0, 1fr);
  column-gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 14rpx;
  border: 1rpx solid #dce5ef;
  border-radius: 8rpx;
  background: #ffffff;
  transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.address-card:last-child {
  margin-bottom: 0;
}

.address-card.selected {
  border-color: #1769e0;
  background: #eef5ff;
  box-shadow: inset 6rpx 0 0 #1769e0, 0 10rpx 24rpx rgba(23, 105, 224, 0.12);
}

.address-card-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-top: 2rpx;
  border: 2rpx solid #b9c7da;
  border-radius: 8rpx;
  background: #f8fbff;
  box-shadow: inset 0 0 0 4rpx #ffffff;
  transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.address-card-check.checked {
  border-color: #1769e0;
  background: #1769e0;
  box-shadow: 0 8rpx 18rpx rgba(23, 105, 224, 0.22);
}

.address-card-checkmark {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.address-card-body {
  min-width: 0;
}

.address-card-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  column-gap: 12rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 800;
}

.address-card.selected .address-card-title {
  color: #0f4fb5;
}

.address-card-phone {
  flex: 0 0 auto;
  color: #52627a;
  font-size: 22rpx;
  font-weight: 700;
}

.address-card-main {
  display: block;
  margin-top: 6rpx;
  color: #2c3d56;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.address-card-note {
  display: block;
  margin-top: 6rpx;
  color: #7a889d;
  font-size: 22rpx;
  line-height: 1.45;
}

.address-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 12rpx;
  margin-top: 18rpx;
}

.address-actions button {
  width: 100%;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  column-gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e2e8f0;
  background: #ffffff;
  box-shadow: 0 -12rpx 30rpx rgba(15, 23, 42, 0.08);
}

.bottom-btn {
  width: 100%;
}
