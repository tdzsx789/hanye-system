<view class="page-shell form-page">
  <view class="form-head">
    <view>
      <text class="form-title">{{title}}</text>
      <text class="form-subtitle">{{subtitle}}</text>
    </view>
    <text class="status-chip {{form.status === '已审核' ? 'status-audited' : form.status === '已签收' ? 'status-signed' : form.status === '通关中' ? 'status-crossing' : form.status === '异常滞留' || form.status === '费用待确认' || form.status === '缺票据' ? 'status-exception' : form.status === '正常' || form.status === '已派车' ? 'status-dispatched' : 'status-planned'}}">{{form.status || '预排'}}</text>
  </view>

  <view wx:if="{{loadingRefs}}" class="panel loading-panel">
    <view class="loading-spinner"></view>
    <view class="loading-copy">
      <text class="loading-title">正在载入排车单资料</text>
      <text class="loading-subtitle">正在读取客户、车辆、司机和地址资料，请稍候</text>
    </view>
  </view>

  <block wx:else>
    <view class="panel form-panel">
      <view class="section-title">基础信息</view>
      <view class="field-row">
        <text class="field-label">{{isOrderEditMode ? '订单日期' : '排车日期'}}</text>
        <picker mode="date" value="{{form.date}}" bindchange="onFormDateChange">
          <view class="picker-box">{{form.date || '请选择日期'}}</view>
        </picker>
      </view>
      <view wx:if="{{isOrderEditMode}}" class="field-row">
        <text class="field-label">状态</text>
        <picker range="{{orderStatusOptions}}" data-field="status" data-options-key="orderStatusOptions" bindchange="onPickerChange">
          <view class="picker-box">{{form.status || '请选择状态'}}</view>
        </picker>
      </view>
      <view class="field-row customer-field">
        <text class="field-label">客户</text>
        <input placeholder="搜索并选择客户" placeholder-class="placeholder" value="{{form.customer}}" data-field="customer" bindfocus="onCustomerFocus" bindinput="onFieldInput" />
        <view wx:if="{{customerPickerOpen}}" class="suggestion-box">
          <view wx:for="{{customerSuggestions}}" wx:key="id" class="suggestion-item" data-id="{{item.id}}" bindtap="selectCustomer">
            <text class="suggestion-primary">{{item.displayName || item.name}}</text>
            <text wx:if="{{item.secondaryText}}" class="suggestion-secondary">{{item.secondaryText}}</text>
          </view>
          <view wx:if="{{!customerSuggestions.length}}" class="suggestion-empty">没有匹配客户，请先在 PC 端维护客户资料</view>
          <button class="quiet-btn suggestion-close" bindtap="closeCustomerPicker">收起</button>
        </view>
      </view>
      <view class="two-col">
        <view class="field-row">
          <text class="field-label">业务类型</text>
          <picker range="{{businessTypeOptions}}" data-field="businessType" data-options-key="businessTypeOptions" bindchange="onPickerChange">
            <view class="picker-box">{{form.businessType || '运输'}}</view>
          </picker>
        </view>
        <view class="field-row">
          <text class="field-label">币种</text>
          <picker range="{{currencyOptions}}" data-field="currency" data-options-key="currencyOptions" bindchange="onPickerChange">
            <view class="picker-box">{{form.currency || '港币'}}</view>
          </picker>
        </view>
      </view>
    </view>

    <view class="panel form-panel">
      <view class="section-title">车辆与路线</view>
      <view class="field-row">
        <text class="field-label">车辆来源</text>
        <picker range="{{vehicleSourceOptions}}" data-field="vehicleSource" data-options-key="vehicleSourceOptions" bindchange="onPickerChange">
          <view class="picker-box">{{form.vehicleSource || '请选择车辆来源'}}</view>
        </picker>
      </view>
      <view class="field-row">
        <text class="field-label">车牌</text>
        <picker wx:if="{{form.vehicleSource === '本公司车辆' && plateOptions.length}}" range="{{plateOptions}}" data-field="plate" data-options-key="plateOptions" bindchange="onPickerChange">
          <view class="picker-box">{{form.plate || '请选择车牌'}}</view>
        </picker>
        <input wx:else placeholder="输入车牌/待定" placeholder-class="placeholder" value="{{form.plate}}" data-field="plate" bindinput="onFieldInput" />
      </view>
      <view wx:if="{{form.vehicleSource === '外派车辆'}}" class="field-row">
        <text class="field-label">外派供应商</text>
        <picker wx:if="{{supplierOptions.length}}" range="{{supplierOptions}}" data-field="supplier" data-options-key="supplierOptions" bindchange="onPickerChange">
          <view class="picker-box">{{form.supplier || '请选择供应商'}}</view>
        </picker>
        <input wx:else placeholder="输入供应商名称" placeholder-class="placeholder" value="{{form.supplier}}" data-field="supplier" bindinput="onFieldInput" />
      </view>
      <view class="two-col">
        <view class="field-row">
          <text class="field-label">口岸</text>
          <picker range="{{portOptions}}" data-field="port" data-options-key="portOptions" bindchange="onPickerChange">
            <view class="picker-box">{{form.port || '请选择'}}</view>
          </picker>
        </view>
        <view class="field-row">
          <text class="field-label">进出口</text>
          <picker range="{{directionOptions}}" data-field="direction" data-options-key="directionOptions" bindchange="onPickerChange">
            <view class="picker-box">{{form.direction || '请选择'}}</view>
          </picker>
        </view>
      </view>
      <view class="two-col">
        <view class="field-row">
          <text class="field-label">吨位</text>
          <picker range="{{tonnageOptions}}" data-field="tonnage" data-options-key="tonnageOptions" bindchange="onPickerChange">
            <view class="picker-box">{{form.tonnage || '请选择'}}</view>
          </picker>
        </view>
        <view class="field-row">
          <text class="field-label">件数/板数</text>
          <input placeholder="例如：20件 / 4板" placeholder-class="placeholder" value="{{form.quantity}}" data-field="quantity" bindinput="onFieldInput" />
        </view>
      </view>
      <view class="two-col">
        <view class="field-row">
          <text class="field-label">重量</text>
          <input placeholder="例如：1200kg" placeholder-class="placeholder" value="{{form.weight}}" data-field="weight" bindinput="onFieldInput" />
        </view>
        <view class="field-row">
          <text class="field-label">装车时间</text>
          <picker mode="multiSelector" range="{{loadTimePickerRange}}" value="{{loadTimePickerValue}}" bindchange="onLoadTimePickerChange">
            <view class="picker-box">{{form.loadTime || '未定'}}</view>
          </picker>
        </view>
      </view>
      <view class="field-row">
        <view class="switch-field" bindtap="toggleNeedsWeighing">
          <view class="switch-copy">
            <text class="field-label switch-label">是否过磅</text>
            <text class="switch-hint">{{form.needsWeighing ? '派车信息显示过磅' : '派车信息显示不用过磅'}}</text>
          </view>
          <switch checked="{{form.needsWeighing}}" color="#1769e0" bindchange="onNeedsWeighingChange" catchtap="noop" />
        </view>
      </view>
      <view class="field-row">
        <text class="field-label">备注</text>
        <input placeholder="{{isOrderEditMode ? '订单备注' : '排车备注'}}" placeholder-class="placeholder" value="{{form.note}}" data-field="note" bindinput="onFieldInput" />
      </view>
      <view wx:if="{{isOrderEditMode}}" class="two-col">
        <view class="field-row">
          <view class="switch-field" data-field="tripNoEnabled" bindtap="toggleBooleanField">
            <view class="switch-copy">
              <text class="field-label switch-label">车次号</text>
              <text class="switch-hint">{{form.tripNoEnabled ? '已启用' : '未启用'}}</text>
            </view>
            <switch checked="{{form.tripNoEnabled}}" color="#1769e0" data-field="tripNoEnabled" bindchange="onBooleanFieldChange" catchtap="noop" />
          </view>
        </view>
        <view class="field-row">
          <view class="switch-field" data-field="sixSheetEnabled" bindtap="toggleBooleanField">
            <view class="switch-copy">
              <text class="field-label switch-label">六联单号</text>
              <text class="switch-hint">{{form.sixSheetEnabled ? '已启用' : '未启用'}}</text>
            </view>
            <switch checked="{{form.sixSheetEnabled}}" color="#1769e0" data-field="sixSheetEnabled" bindchange="onBooleanFieldChange" catchtap="noop" />
          </view>
        </view>
      </view>
      <view wx:if="{{isOrderEditMode && form.tripNoEnabled}}" class="field-row">
        <text class="field-label">车次号</text>
        <input placeholder="请输入车次号" placeholder-class="placeholder" value="{{form.tripNo}}" data-field="tripNo" bindinput="onFieldInput" />
      </view>
      <view wx:if="{{isOrderEditMode && form.sixSheetEnabled}}" class="field-row">
        <text class="field-label">六联单号</text>
        <input placeholder="请输入六联单号" placeholder-class="placeholder" value="{{form.sixSheetNo}}" data-field="sixSheetNo" bindinput="onFieldInput" />
      </view>
    </view>

    <view wx:if="{{form.vehicleSource === '本公司车辆'}}" class="panel form-panel">
      <view class="section-title">运输模式</view>
      <view class="field-row">
        <text class="field-label">运输模式</text>
        <picker range="{{transportModeOptions}}" data-field="transportMode" data-options-key="transportModeOptions" bindchange="onPickerChange">
          <view class="picker-box">{{form.transportMode || '请选择运输模式'}}</view>
        </picker>
      </view>
      <view wx:if="{{!form.transportMode || form.transportMode === '单司机'}}" class="field-row">
        <text class="field-label">香港司机</text>
        <picker wx:if="{{hkDriverOptions.length}}" range="{{hkDriverOptions}}" data-field="driver" data-options-key="hkDriverOptions" bindchange="onPickerChange">
          <view class="picker-box">{{form.driver || '请选择香港司机'}}</view>
        </picker>
        <input wx:else placeholder="香港司机" placeholder-class="placeholder" value="{{form.driver}}" data-field="driver" bindinput="onFieldInput" />
      </view>
      <view wx:elif="{{form.transportMode === '双司机'}}" class="two-col">
        <view class="field-row">
          <text class="field-label">香港司机</text>
          <picker wx:if="{{hkDriverOptions.length}}" range="{{hkDriverOptions}}" data-field="hkDriver" data-options-key="hkDriverOptions" bindchange="onPickerChange">
            <view class="picker-box">{{form.hkDriver || '请选择香港司机'}}</view>
          </picker>
          <input wx:else placeholder="香港司机" placeholder-class="placeholder" value="{{form.hkDriver}}" data-field="hkDriver" bindinput="onFieldInput" />
        </view>
        <view class="field-row">
          <text class="field-label">大陆骑师</text>
          <picker wx:if="{{mainlandDriverOptions.length}}" range="{{mainlandDriverOptions}}" data-field="mainlandDriver" data-options-key="mainlandDriverOptions" bindchange="onPickerChange">
            <view class="picker-box">{{form.mainlandDriver || '请选择大陆骑师'}}</view>
          </picker>
          <input wx:else placeholder="大陆骑师" placeholder-class="placeholder" value="{{form.mainlandDriver}}" data-field="mainlandDriver" bindinput="onFieldInput" />
        </view>
      </view>
      <view wx:elif="{{form.transportMode === '口岸转国内车'}}" class="two-col">
        <view class="field-row">
          <text class="field-label">香港司机</text>
          <picker wx:if="{{hkDriverOptions.length}}" range="{{hkDriverOptions}}" data-field="hkDriver" data-options-key="hkDriverOptions" bindchange="onPickerChange">
            <view class="picker-box">{{form.hkDriver || '请选择香港司机'}}</view>
          </picker>
          <input wx:else placeholder="香港司机" placeholder-class="placeholder" value="{{form.hkDriver}}" data-field="hkDriver" bindinput="onFieldInput" />
        </view>
        <view class="field-row">
          <text class="field-label">国内车牌号</text>
          <input placeholder="例如：粤B12345" placeholder-class="placeholder" value="{{form.mainlandDriver}}" data-field="mainlandDriver" bindinput="onFieldInput" />
        </view>
      </view>
    </view>

    <view class="panel form-panel location-panel">
      <view class="location-head">
        <view>
          <text class="section-title">装货地</text>
          <text class="location-hint">点击选择联系人地址，支持多个地址。</text>
        </view>
        <text class="location-count {{loadingEntryCount ? '' : 'empty'}}">{{loadingEntryCount ? '共 ' + loadingEntryCount + ' 个地址' : '未选择地址'}}</text>
      </view>
      <view class="location-edit-list">
        <view wx:for="{{loadingEntries}}" wx:for-item="entry" wx:for-index="entryIndex" wx:key="id" class="location-edit-item">
          <text class="location-index">{{entryIndex + 1}}</text>
          <view class="location-edit-fields">
            <view class="location-edit-field">
              <input placeholder="市" placeholder-class="placeholder" value="{{entry.city}}" data-target="loading" data-index="{{entryIndex}}" data-part="city" bindfocus="onLocationPartFocus" bindinput="onLocationPartInput" bindblur="scheduleCloseLocationSuggestion" />
              <view wx:if="{{locationSuggestionTarget == 'loading' && locationSuggestionIndex == entryIndex && locationSuggestionPart == 'city'}}" class="mini-suggestion-box">
                <view wx:if="{{locationSuggestionOptions.length}}">
                  <view wx:for="{{locationSuggestionOptions}}" wx:for-item="option" wx:key="*this" class="mini-suggestion-item" data-target="loading" data-index="{{entryIndex}}" data-part="city" data-value="{{option}}" bindtap="selectLocationSuggestion">{{option}}</view>
                </view>
                <view wx:else class="mini-suggestion-empty">暂无匹配，可直接输入</view>
              </view>
            </view>
            <view class="location-edit-field">
              <input placeholder="区" placeholder-class="placeholder" value="{{entry.district}}" data-target="loading" data-index="{{entryIndex}}" data-part="district" bindfocus="onLocationPartFocus" bindinput="onLocationPartInput" bindblur="scheduleCloseLocationSuggestion" />
              <view wx:if="{{locationSuggestionTarget == 'loading' && locationSuggestionIndex == entryIndex && locationSuggestionPart == 'district'}}" class="mini-suggestion-box">
                <view wx:if="{{locationSuggestionOptions.length}}">
                  <view wx:for="{{locationSuggestionOptions}}" wx:for-item="option" wx:key="*this" class="mini-suggestion-item" data-target="loading" data-index="{{entryIndex}}" data-part="district" data-value="{{option}}" bindtap="selectLocationSuggestion">{{option}}</view>
                </view>
                <view wx:else class="mini-suggestion-empty">暂无匹配，可直接输入</view>
              </view>
            </view>
            <input class="location-detail-input" placeholder="详细地址" placeholder-class="placeholder" value="{{entry.detail}}" data-target="loading" data-index="{{entryIndex}}" data-part="detail" bindfocus="clearLocationSuggestion" bindinput="onLocationPartInput" />
          </view>
          <view wx:if="{{loadingEntries.length > 1 && entryIndex > 0}}" class="location-remove-btn" data-target="loading" data-index="{{entryIndex}}" bindtap="removeLocationEntry">
            <text class="location-remove-icon">×</text>
          </view>
        </view>
      </view>
      <view class="location-button-row">
        <view class="location-action-btn" data-target="loading" bindtap="addLocationEntry">新增装货地</view>
        <view class="location-action-btn" data-target="loading" bindtap="openLocationPicker">选择联系人地址</view>
      </view>
    </view>

    <view class="panel form-panel location-panel">
      <view class="location-head">
        <view>
          <text class="section-title">卸货地</text>
          <text class="location-hint">点击选择联系人地址，支持多个地址。</text>
        </view>
        <text class="location-count {{unloadingEntryCount ? '' : 'empty'}}">{{unloadingEntryCount ? '共 ' + unloadingEntryCount + ' 个地址' : '未选择地址'}}</text>
      </view>
      <view class="location-edit-list">
        <view wx:for="{{unloadingEntries}}" wx:for-item="entry" wx:for-index="entryIndex" wx:key="id" class="location-edit-item">
          <text class="location-index">{{entryIndex + 1}}</text>
          <view class="location-edit-fields">
            <view class="location-edit-field">
              <input placeholder="市" placeholder-class="placeholder" value="{{entry.city}}" data-target="unloading" data-index="{{entryIndex}}" data-part="city" bindfocus="onLocationPartFocus" bindinput="onLocationPartInput" bindblur="scheduleCloseLocationSuggestion" />
              <view wx:if="{{locationSuggestionTarget == 'unloading' && locationSuggestionIndex == entryIndex && locationSuggestionPart == 'city'}}" class="mini-suggestion-box">
                <view wx:if="{{locationSuggestionOptions.length}}">
                  <view wx:for="{{locationSuggestionOptions}}" wx:for-item="option" wx:key="*this" class="mini-suggestion-item" data-target="unloading" data-index="{{entryIndex}}" data-part="city" data-value="{{option}}" bindtap="selectLocationSuggestion">{{option}}</view>
                </view>
                <view wx:else class="mini-suggestion-empty">暂无匹配，可直接输入</view>
              </view>
            </view>
            <view class="location-edit-field">
              <input placeholder="区" placeholder-class="placeholder" value="{{entry.district}}" data-target="unloading" data-index="{{entryIndex}}" data-part="district" bindfocus="onLocationPartFocus" bindinput="onLocationPartInput" bindblur="scheduleCloseLocationSuggestion" />
              <view wx:if="{{locationSuggestionTarget == 'unloading' && locationSuggestionIndex == entryIndex && locationSuggestionPart == 'district'}}" class="mini-suggestion-box">
                <view wx:if="{{locationSuggestionOptions.length}}">
                  <view wx:for="{{locationSuggestionOptions}}" wx:for-item="option" wx:key="*this" class="mini-suggestion-item" data-target="unloading" data-index="{{entryIndex}}" data-part="district" data-value="{{option}}" bindtap="selectLocationSuggestion">{{option}}</view>
                </view>
                <view wx:else class="mini-suggestion-empty">暂无匹配，可直接输入</view>
              </view>
            </view>
            <input class="location-detail-input" placeholder="详细地址" placeholder-class="placeholder" value="{{entry.detail}}" data-target="unloading" data-index="{{entryIndex}}" data-part="detail" bindfocus="clearLocationSuggestion" bindinput="onLocationPartInput" />
          </view>
          <view wx:if="{{unloadingEntries.length > 1 && entryIndex > 0}}" class="location-remove-btn" data-target="unloading" data-index="{{entryIndex}}" bindtap="removeLocationEntry">
            <text class="location-remove-icon">×</text>
          </view>
        </view>
      </view>
      <view class="location-button-row">
        <view class="location-action-btn" data-target="unloading" bindtap="addLocationEntry">新增卸货地</view>
        <view class="location-action-btn" data-target="unloading" bindtap="openLocationPicker">选择联系人地址</view>
      </view>
    </view>

    <view wx:if="{{isOrderEditMode}}" class="panel form-panel fee-panel">
      <view class="location-head">
        <view>
          <text class="section-title">收费项目</text>
          <text class="location-hint">和 Web 端订单费用一起保存。</text>
        </view>
        <button class="ghost-btn fee-add-btn" bindtap="addOrderFeeRow">新增项目</button>
      </view>
      <view wx:for="{{orderFeeRows}}" wx:for-item="fee" wx:for-index="feeIndex" wx:key="*this" class="fee-card">
        <view class="fee-card-head">
          <text>项目 {{feeIndex + 1}}</text>
          <button wx:if="{{orderFeeRows.length > 1}}" class="fee-remove-btn" data-index="{{feeIndex}}" bindtap="removeOrderFeeRow">删除</button>
        </view>
        <view class="two-col">
          <view class="field-row">
            <text class="field-label">类别</text>
            <picker range="{{feeCategoryOptions}}" data-index="{{feeIndex}}" data-field="category" data-options-key="feeCategoryOptions" bindchange="onOrderFeePickerChange">
              <view class="picker-box">{{fee.category || '正常'}}</view>
            </picker>
          </view>
          <view class="field-row">
            <text class="field-label">币种</text>
            <picker range="{{currencyOptions}}" data-index="{{feeIndex}}" data-field="currency" data-options-key="currencyOptions" bindchange="onOrderFeePickerChange">
              <view class="picker-box">{{fee.currency || '港币'}}</view>
            </picker>
          </view>
        </view>
        <view class="field-row">
          <text class="field-label">项目名称</text>
          <input placeholder="例如：中港运费" placeholder-class="placeholder" value="{{fee.name}}" data-index="{{feeIndex}}" data-field="name" bindinput="onOrderFeeInput" />
        </view>
        <view class="two-col">
          <view class="field-row">
            <text class="field-label">数量</text>
            <input type="digit" placeholder="1" placeholder-class="placeholder" value="{{fee.quantity}}" data-index="{{feeIndex}}" data-field="quantity" bindinput="onOrderFeeInput" />
          </view>
          <view class="field-row">
            <text class="field-label">单价</text>
            <input type="digit" placeholder="0" placeholder-class="placeholder" value="{{fee.unitPrice}}" data-index="{{feeIndex}}" data-field="unitPrice" bindinput="onOrderFeeInput" />
          </view>
        </view>
        <view class="two-col">
          <view class="field-row">
            <text class="field-label">金额</text>
            <input type="digit" placeholder="0" placeholder-class="placeholder" value="{{fee.amount}}" data-index="{{feeIndex}}" data-field="amount" bindinput="onOrderFeeInput" />
          </view>
          <view class="field-row">
            <text class="field-label">成本</text>
            <input type="digit" placeholder="可不填" placeholder-class="placeholder" value="{{fee.cost}}" data-index="{{feeIndex}}" data-field="cost" bindinput="onOrderFeeInput" />
          </view>
        </view>
        <view class="field-row">
          <text class="field-label">备注</text>
          <input placeholder="费用备注" placeholder-class="placeholder" value="{{fee.remark}}" data-index="{{feeIndex}}" data-field="remark" bindinput="onOrderFeeInput" />
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{locationPickerOpen}}" class="sheet-mask location-picker-mask" bindtap="closeLocationPicker">
    <view class="location-sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-head-copy">
          <text class="sheet-title">{{locationPickerTitle}}</text>
          <text class="sheet-subtitle">{{form.customer || '未选择客户'}}</text>
        </view>
        <button class="quiet-btn sheet-close" bindtap="closeLocationPicker">关闭</button>
      </view>

      <view wx:if="{{!addressBookCustomerReady}}" class="address-picker-note">先选客户，再读取和保存联系人地址。</view>

      <view class="location-toolbar">
        <input class="location-search" placeholder="联系人 / 电话 / 地址 / 备注" placeholder-class="placeholder" value="{{addressBookKeyword}}" bindinput="onAddressBookKeywordInput" />
        <button class="primary-btn small location-new-btn" bindtap="toggleAddressBookForm">{{addressBookFormOpen ? '收起新建' : '新建地址'}}</button>
      </view>

      <view wx:if="{{addressBookFormOpen}}" class="address-form">
        <view class="two-col">
          <view class="field-row">
            <text class="field-label">市</text>
            <input placeholder="搜索或输入市" placeholder-class="placeholder" value="{{addressBookForm.city}}" data-field="city" bindfocus="onAddressBookLocationFocus" bindinput="onAddressBookFormInput" bindblur="scheduleCloseAddressBookSuggestion" />
            <view wx:if="{{addressBookSuggestionPart == 'city'}}" class="mini-suggestion-box">
              <view wx:if="{{addressBookSuggestionOptions.length}}">
                <view wx:for="{{addressBookSuggestionOptions}}" wx:for-item="option" wx:key="*this" class="mini-suggestion-item" data-field="city" data-value="{{option}}" bindtap="selectAddressBookSuggestion">{{option}}</view>
              </view>
              <view wx:else class="mini-suggestion-empty">暂无匹配，可直接输入</view>
            </view>
          </view>
          <view class="field-row">
            <text class="field-label">区</text>
            <input placeholder="搜索或输入区" placeholder-class="placeholder" value="{{addressBookForm.district}}" data-field="district" bindfocus="onAddressBookLocationFocus" bindinput="onAddressBookFormInput" bindblur="scheduleCloseAddressBookSuggestion" />
            <view wx:if="{{addressBookSuggestionPart == 'district'}}" class="mini-suggestion-box">
              <view wx:if="{{addressBookSuggestionOptions.length}}">
                <view wx:for="{{addressBookSuggestionOptions}}" wx:for-item="option" wx:key="*this" class="mini-suggestion-item" data-field="district" data-value="{{option}}" bindtap="selectAddressBookSuggestion">{{option}}</view>
              </view>
              <view wx:else class="mini-suggestion-empty">暂无匹配，可直接输入</view>
            </view>
          </view>
        </view>
        <view class="field-row">
          <text class="field-label">详细地址</text>
          <input placeholder="详细地址" placeholder-class="placeholder" value="{{addressBookForm.address}}" data-field="address" bindfocus="clearAddressBookSuggestion" bindinput="onAddressBookFormInput" />
        </view>
        <view class="two-col">
          <view class="field-row">
            <text class="field-label">联系人</text>
            <input placeholder="联系人" placeholder-class="placeholder" value="{{addressBookForm.contact}}" data-field="contact" bindfocus="clearAddressBookSuggestion" bindinput="onAddressBookFormInput" />
          </view>
          <view class="field-row">
            <text class="field-label">电话</text>
            <input placeholder="电话 / 手机" placeholder-class="placeholder" value="{{addressBookForm.phone}}" data-field="phone" bindfocus="clearAddressBookSuggestion" bindinput="onAddressBookFormInput" />
          </view>
        </view>
        <view class="field-row">
          <text class="field-label">备注</text>
          <input placeholder="楼栋、门牌、仓库名" placeholder-class="placeholder" value="{{addressBookForm.note}}" data-field="note" bindinput="onAddressBookFormInput" />
        </view>
        <button class="primary-btn address-save-btn" loading="{{addressBookSaving}}" disabled="{{addressBookSaving}}" bindtap="saveAddressBookEntry">保存到联系人</button>
      </view>

      <view class="address-list-head">
        <text>{{addressBookVisibleRows.length ? '左侧勾选地址后点确定' : (addressBookCustomerReady ? '暂无地址，请先新建地址' : '请先选择客户，再查看或新建联系人地址')}}</text>
        <text>{{addressBookSelectedIds.length}} 项</text>
      </view>

      <view wx:if="{{addressBookLoading}}" class="address-empty">正在读取联系人地址...</view>
      <view wx:elif="{{addressBookKeyword && !addressBookVisibleRows.length}}" class="address-empty">没有匹配地址，请清空搜索或新建地址。</view>
      <view wx:elif="{{!addressBookVisibleRows.length && addressBookCustomerReady}}" class="address-empty">暂无地址，请先新建地址。</view>
      <view wx:elif="{{!addressBookVisibleRows.length}}" class="address-empty">请先选择客户后再查看或新建联系人地址。</view>
      <scroll-view wx:else scroll-y class="address-list">
        <view wx:for="{{addressBookVisibleRows}}" wx:key="id" class="address-card {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleAddressBookSelection">
          <view class="address-card-check {{item.selected ? 'checked' : ''}}">
            <text wx:if="{{item.selected}}" class="address-card-checkmark">✓</text>
          </view>
          <view class="address-card-body">
            <view class="address-card-title">
              <text>{{item.contact || '未填联系人'}}</text>
              <text wx:if="{{item.phone}}" class="address-card-phone">{{item.phone}}</text>
            </view>
            <text class="address-card-main">{{item.area ? item.area + ' / ' : ''}}{{item.address || item.value || '未填写地址'}}</text>
            <text wx:if="{{item.note}}" class="address-card-note">{{item.note}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="address-actions">
        <button class="ghost-btn" bindtap="closeLocationPicker">取消</button>
        <button class="primary-btn" type="button" bindtap="applySelectedAddressBookEntries" disabled="{{!addressBookSelectedIds.length}}">确定</button>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="ghost-btn bottom-btn" bindtap="cancelForm" disabled="{{saving}}">取消</button>
    <button class="primary-btn bottom-btn" bindtap="submitForm" loading="{{saving}}" disabled="{{loadingRefs || saving}}">{{isOrderEditMode ? '保存订单' : '保存排车单'}}</button>
  </view>
</view>
