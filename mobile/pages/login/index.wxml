<view class="login-page">
  <view class="brand">
    <text class="brand-title">汉业排车</text>
    <text class="brand-subtitle">跟单员移动排车端</text>
  </view>

  <view wx:if="{{checking}}" class="login-panel loading-panel">
    <text>正在检查登录状态...</text>
  </view>

  <view wx:else class="login-panel">
    <view class="form-line">
      <text class="field-label">账号</text>
      <input placeholder="请输入系统账号" placeholder-class="placeholder" data-field="username" value="{{username}}" bindinput="onFieldInput" />
    </view>
    <view class="form-line">
      <text class="field-label">密码</text>
      <input password placeholder="请输入密码" placeholder-class="placeholder" data-field="password" value="{{password}}" bindinput="onFieldInput" confirm-type="done" bindconfirm="submitLogin" />
    </view>
    <view class="form-line server-line">
      <text class="field-label">服务器地址</text>
      <input placeholder="例如：https://www.example.com/api" placeholder-class="placeholder" data-field="apiBaseUrl" value="{{apiBaseUrl}}" bindinput="onFieldInput" />
    </view>
    <button class="primary-btn login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="submitLogin">登录排车端</button>
  </view>
</view>
